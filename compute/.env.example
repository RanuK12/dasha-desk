# Coordinator
PORT=8787
HOST=127.0.0.1
DASHA_API_KEY=change-this-consumer-key
DASHA_PROVIDER_KEY=change-this-provider-key
DASHA_CORS_ORIGIN=http://localhost:3000
JOB_TIMEOUT_MS=120000

# OpenRouter provider listing (alpha) — set DASHA_OPENROUTER_KEY to a fresh
# secret before exposing the coordinator to OpenRouter. Never reuse
# DASHA_API_KEY. Rotate by restarting with a new value.
DASHA_PROVIDER_SLUG=dasha
DASHA_OPENROUTER_KEY=
OPENROUTER_RATE_LIMIT_RPM=60
OPENROUTER_RATE_LIMIT_BURST=10
OPENROUTER_QUEUE_TIMEOUT_MS=25000
OPENROUTER_KEEPALIVE_MS=10000
OPENROUTER_IS_FREE=true

# Provider agent
DASHA_COORDINATOR_URL=http://127.0.0.1:8787
DASHA_PROVIDER_NAME=my-mac
DASHA_MODEL_MAP=qwen3-8b=qwen3:8b,gemma3-12b=gemma3:12b
OLLAMA_URL=http://127.0.0.1:11434
